ntname":"Arial Bold","fontsize":10},{"id":"obj-16","maxclass":"newobj","text":"sah~ 0.0001","rect":[200,360,67,18],"patchingRect":[200,360,67,18],"numinlets":2,"numoutlets":1,"fontname":"Arial Bold","fontsize":10},{"id":"obj-15","maxclass":"newobj","text":"sah~ 0.0001","rect":[104,360,67,18],"patchingRect":[104,360,67,18],"numinlets":2,"numoutlets":1,"fontname":"Arial Bold","fontsize":10},{"id":"obj-90","maxclass":"number~","text":"0","rect":[104,288,55,18],"patchingRect":[104,288,55,18],"numinlets":2,"numoutlets":2,"fontname":"Arial Bold","fontsize":10},{"id":"obj-11","maxclass":"comment","text":"Delay time (ms)","rect":[123,176,84,18],"patchingRect":[123,176,84,18],"numinlets":1,"numoutlets":0,"fontname":"Arial Bold","fontsize":10,"textcolor":[0.3,0.34,0.4,1]},{"id":"obj-10","maxclass":"comment","text":"0) We're using a number~ object to convert the incoming delay value into a continuous signal domain","rect":[120,208,104,75],"patchingRect":[120,208,104,75],"numinlets":1,"numoutlets":0,"fontname":"Arial","fontsize":10,"linecount":6},{"id":"obj-51","maxclass":"inlet","text":"","rect":[104,176,18,18],"patchingRect":[104,176,18,18],"numinlets":0,"numoutlets":1}],"lines":[{"id":"pline-0","sourceId":"obj-1","sourceOutlet":0,"targetId":"obj-18","targetInlet":0,"midpoints":[32.5,393,113.5,393]},{"id":"pline-1","sourceId":"obj-22","sourceOutlet":0,"targetId":"obj-23","targetInlet":1,"midpoints":[209.5,507,127,507]},{"id":"pline-2","sourceId":"obj-23","sourceOutlet":0,"targetId":"obj-52","targetInlet":0},{"id":"pline-3","sourceId":"obj-17","sourceOutlet":0,"targetId":"obj-22","targetInlet":1},{"id":"pline-4","sourceId":"obj-24","sourceOutlet":0,"targetId":"obj-21","targetInlet":1},{"id":"pline-5","sourceId":"obj-24","sourceOutlet":0,"targetId":"obj-15","targetInlet":1},{"id":"pline-6","sourceId":"obj-25","sourceOutlet":0,"targetId":"obj-24","targetInlet":0},{"id":"pline-7","sourceId":"obj-24","sourceOutlet":0,"targetId":"obj-17","targetInlet":0},{"id":"pline-8","sourceId":