-27","maxclass":"attrui","text":"@overlap","rect":[358,190,150,23],"patchingRect":[358,190,150,23],"numinlets":1,"numoutlets":1,"attr":"overlap","parameterEnable":0},{"id":"obj-24","maxclass":"attrui","text":"@float32","rect":[358,218,150,23],"patchingRect":[358,218,150,23],"numinlets":1,"numoutlets":1,"attr":"float32","parameterEnable":0},{"id":"obj-23","maxclass":"message","text":"patchername pfft_loadme.maxpat","rect":[122,190,202,23],"patchingRect":[122,190,202,23],"numinlets":2,"numoutlets":1},{"id":"obj-22","maxclass":"message","text":"patchername pfft_loadme2.maxpat","rect":[100,159,209,23],"patchingRect":[100,159,209,23],"numinlets":2,"numoutlets":1},{"id":"obj-11","maxclass":"newobj","text":"cycle~ 5000","rect":[13.5,158,78,23],"patchingRect":[13.5,158,78,23],"numinlets":2,"numoutlets":1},{"id":"obj-8","maxclass":"spectroscope~","text":"","rect":[13.5,313,207,66],"patchingRect":[13.5,313,207,66],"numinlets":2,"numoutlets":1},{"id":"obj-5","maxclass":"newobj","text":"pfft~ pfft_loadme @fftsize 1024 @overlap 8 @float32 1 @args 1 two 3 IV","rect":[13.5,271,429,23],"patchingRect":[13.5,271,429,23],"numinlets":2,"numoutlets":2,"fontname":"Arial","fontsize":13,"fontface":0},{"id":"obj-2","maxclass":"comment","text":"New in Max 9.1, pfft~ has attributes to dynamically change patcher and other fft attribtues like fftsize, overlap, fullspectrum, float32, or legacy. These attribute changes require either a toggle of audio off/on, or a reload of the patcher file to take effect when changed audio signal processing on.","rect":[10,77,604,50],"patchingRect":[10,77,604,50],"numinlets":1,"numoutlets":0,"linecount":3},{"id":"obj-25","maxclass":"textbutton","text":"1","rect":[173,401,20,20],"patchingRect":[173,401,20,20],"ignoreclick":1,"numinlets":1,"numoutlets":3,"fontname":"Arial Bold","textcolor":[0.34902,0.34902,0.34902,1],"bgcolor":[0.9,0.65,0.05,1],"parameterEnable":0},{"id":"obj-26","maxclass":"comment","text":"turn on audio","rect":[63,398,108,25],"patchingRect":[63,398,108,25],"numinlets":1,"numoutlets":0,"fontname":"Arial","fontsize":13,"bubble":1},{"id":"obj-10","maxclass":"ezdac~","text":"","rect":[10,389,44,44],"patchingRect":[10,389,44,44],"numinlets":2,"numoutlets":0},{"id":"obj-6","maxclass":"attrui","text":"@fftsize","rect":[358,163,150,23],"patchingRect":[358,163,150,23],"numinlets":1,"numoutlets":1,"attr":"fftsize","parameterEnable":0}],"lines":[{"id":"pline-0","sourceId":"obj-11","sourceOutlet":0,"targetId":"obj-5","targetInlet":0},{"id":"pline-1","sourceId":"obj-22","sourceOutlet":0,"targetId":"obj-5","targetInlet":0},{"id":"pline-2","sourceId":"obj-23","sourceOutlet":0,"targetId":"obj-5","targetInlet":0},{"id":"pline-3","sourceId":"obj-24","sourceOutlet":0,"targetId":"obj-5","targetInlet":0},{"id":"pline-4","sourceId":"obj-27","sourceOutlet":0,"targetId":"obj-5","targetInlet":0},{"id":"pline-5","sourceId":"obj-5","sourceOutlet":0,"targetId":"obj-8","targetInlet":0},{"id":"pline-6","sourceId":"obj-6","sourceOutlet":0,"targetId":"obj-5","targetInlet":0}],"stats":{"boxCount":12,"lineCount":7,"presentationBoxCount":0}},"\"technical details\"":{"pageName":"\"technical details\"","pageId":"technical-details__obj-3","renderMode":"page-subpatcher","patcherRect":[0,26,785,496],"boxes":[{"id":"obj-7","maxclass":"comment","text":"If you are doing an analysis only, and thus have no output, and you are using 2 overlaps, then you may wish to compensate for this internal windowing trick. To do so you take the square root of the window and then apply a constant scaling factor to it, which is the integral of the window. Note that every window has a different scaling factor since the different shape leads to a different integral.","rect":[10,342,589,65],"patchingRect":[10,342,589,65],"numinlets":1,"numoutlets":0,"linecount":4},{"id":"obj-5","maxclass":"comment","text":"To compensate for this, the windowing in the 2-overlap case in pfft~ uses a standard trick where you take the square root of the windowing function, so that when a signal is windowed twice (on both input and output), the square root cancels itself out and you don't get any unwanted modulation on output.","rect":[10,278,604,50],"patchingRect":[10,278,604,50],"numinlets":1,"numoutlets":0,"linecount":3},{"id":"obj-4","maxclass":"comment","text":"An STFT is supposed to use a minimum of 4 overlaps in order to ensure there is a flat amplitude response after having been windowed on both input and output. (Though if you use a Hamming window there is still slight amplitude modulation because it does not quite go to zero at the endpoints).  \n\nFor example, with a triangle window if your input signal is all values of 1 and you window that signal on input to the fft you get a triangle function which is fft'd and inverse fft'd, and then when you window that again on output you will get the square of the triangle function!!!  If you are using 2-overlap, this results in amplitude modulation.","rect":[10,141,608,123],"patchingRect":[10,141,608,123],"numinlets":1,"numoutlets":0,"linecount":8},{"id":"obj-3","maxclass":"comment","text":"Historically, overlapping 2 FFTs was quite common for computational efficiency.  With modern processors it typically makes more sense to use at least 4 overlaps.  If you can blindly accept this, then no problem.  If you are wondering why, then read on.","rect":[10,79,605,50],"patchingRect":[10,79,605,50],"numinlets":1,"numoutlets":0,"linecount":3}],"lines":[],"stats":{"boxCount":4,"lineCount":0,"presentationBoxCount":0}}},"patcherRect":[100,157,785,496],"boxes":[{"id":"obj-25","maxclass":"textbutton","text":"1","rect":[352,413,20,20],"patchingRect":[352,413,20,20],"ignoreclick":1,"numinlets":1,"numoutlets":3,"fontname":"Arial Bold","textcolor":[0.34902,0.34902,0.34902,1],"bgcolor":[0.9,0.65,0.05,1],"parameterEnable":0},{"id":"obj-26","maxclass":"comment","text":"turn on audio","rect":[242,410.5,108,25],"patchingRect":[242,410.5,108,25],"numinlets":1,"numoutlets":0,"fontname":"Arial","fontsize":13,"bubble":1},{"i