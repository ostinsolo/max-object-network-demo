ingRect":[123,96,44,19],"numinlets":1,"numoutlets":1,"fontname":"Arial","fontsize":11.595187},{"id":"obj-12","maxclass":"newobj","text":"*~ 0.2","rect":[123,119,40,19],"patchingRect":[123,119,40,19],"numinlets":2,"numoutlets":1,"fontname":"Arial","fontsize":11.595187},{"id":"obj-21","maxclass":"flonum","text":"0","rect":[347,213,67,19],"patchingRect":[347,213,67,19],"numinlets":1,"numoutlets":2,"fontname":"Arial","fontsize":11.595187,"parameterEnable":0},{"id":"obj-22","maxclass":"newobj","text":"selector~ 3","rect":[50,300,280,19],"patchingRect":[50,300,280,19],"numinlets":4,"numoutlets":1,"fontname":"Arial","fontsize":11.595187},{"id":"obj-23","maxclass":"newobj","text":"svf~ 0.2 radians","rect":[311,249,93,19],"patchingRect":[311,249,93,19],"numinlets":3,"numoutlets":4,"fontname":"Arial","fontsize":11.595187},{"id":"obj-24","maxclass":"newobj","text":"svf~ 0.2 linear","rect":[224,249,83,19],"patchingRect":[224,249,83,19],"numinlets":3,"numoutlets":4,"fontname":"Arial","fontsize":11.595187},{"id":"obj-25","maxclass":"newobj","text":"svf~ 300. Hz","rect":[137,249,82,19],"patchingRect":[137,249,82,19],"numinlets":3,"numoutlets":4,"fontname":"Arial","fontsize":11.595187},{"id":"obj-26","maxclass":"comment","text":"onepole~.help contains yet another example.","rect":[480,346,246,19],"patchingRect":[480,346,246,19],"numinlets":1,"numoutlets":0,"fontname":"Arial","fontsize":11.595187},{"id":"obj-27","maxclass":"comment","text":"svf~ accepts arguments or max messages to change the frequency input mode. it is generally recommended to set the mode with an argument and leave it constant, to avoid confusion.","rect":[480,422,352,45],"patchingRect":[480,422,352,45],"numinlets":1,"numoutlets":0,"fontname":"Arial","fontsize":11.595187,"linecount":3},{"id":"obj-28","maxclass":"comment","text":"try sweeping the cutoff frequency in linear mode, then in radians mode, to appreciate the difference. a similar principle operates in the amplitude domain, where exponential audio faders are used to match our logarithmic perception of loudness.","rect":[480,284,352,58],"patchingRect":[480,284,352,58],"numinlets":1,"numoutlets":0,"fontname":"Arial","fontsize":11.595187,"linecount":4},{"id":"obj-29","maxclass":"comment","text":"radians","rect":[422,231,52,19],"patchingRect":[422,231,52,19],"numinlets":1,"numoutlets":0,"fontname":"Arial","fontsize":11.595187},{"id":"obj-30","maxclass":"comment","text":"linear","rect":[437,174,44,19],"patchingRect":[437,174,44,19],"numinlets":1,"numoutlets":0,"fontname":"Arial","fontsize":11.595187},{"id":"obj-31","maxclass":"comment","text":"Hz","rect":[454,123,23,19],"patchingRect":[454,123,23,19],"numinlets":1,"numoutlets":0,"fontname":"Arial","fontsize":11.595187},{"id":"obj-32","maxclass":"comment","text":"in this mode, input values from (0 -> 1) are interpreted as radians, producing a quarter-cycle sinusoidal mapping to cutoff frequencies. this conforms the frequency mapping to a response that is closer to our logarithmic perception of pitch.","rect":[480,217,334,58],"patchingRect":[480,217,334,58],"numinlets":1,"numoutlets":0,"fontname":"Arial","fontsize":11.595187,"linecount":4},{"id":"obj-33","maxclass":"comment","text":"frequency mapping","rect":[188,10,151,25],"patchingRect":[188,10,151,25],"numinlets":1,"numoutlets":0,"fontname":"Arial","fontsize":16.233263},{"id":"obj-34","maxclass":"comment","text":"this mode is essentially the same, but with a normalized input range. linear input values from (0 -> 1) are mapped to cutoff frequencies in the effective range, (0 -> fs/4).","rect":[480,165,311,45],"patchingRect":[480,165,311,45],"numinlets":1,"numoutlets":0,"fontname":"Arial","fontsize":11.595187,"linecount":3},{"id":"obj-35","maxclass":"comment","text":"this is the default mode. input values set the cutoff frequency directly. therefore, the input range is the same as the cutoff frequency (0 -> fs/4), and response is linear.","rect":[480,112,310,45],"patchingRect":[480,112,310,45],"numinlets":1,"numoutlets":0,"fontname":"Arial","fontsize":11.595187,"linecount":3},{"id":"obj-36","maxclass":"comment","text":"svf~ has three different modes for mapping input values onto cutoff frequency. these are mainly for convenience, but they may also improve efficiency slightly.","rect":[480,49,307,45],"patchingRect":[480,49,307,45],"numinlets":1,"numoutlets":0,"fontname":"Arial","fontsize":11.595187,"linecount":3},{"id":"obj-37","maxclass":"comment","text":"since svf~ only samples its control inputs once per vector, it is more efficient to use the radians mode than to do logarithmic scaling outside the object at audio rate.","rect":[480,369,307,45],"patchingRect":[480,369,307,45],"numinlets":1,"numoutlets":0,"fontname":"Arial","fontsize":11.595187,"linecount":3},{"id":"obj-39","maxclass":"flonum","text":"0","rect":[255.5,213,67,19],"patchingRect":[255.5,213,67,19],"numinlets":1,"numoutlets":2,"fontname":"Arial","fontsize":11.595187,"parameterEnable":0},{"id":"obj-41","maxclass":"newobj","text":"* 11025.","rect":[169,187,57,19],"patchingRect":[169,187,57,19],"numinlets":2,"numoutlets":1,"fontname":"Arial","fontsize":11.595187},{"id":"obj-43","maxclass":"flonum","text":"0","rect":[168.5,213,67,19],"patchingRect":[168.5,213,67,19],"numinlets":1,"numoutlets":2,"fontname":"Arial","fontsize":11.595187,"parameterEnable":0}],"lines":[{"id":"pline-0","sourceId":"obj-1","sourceOutlet":0,"targetId":"obj-22","targetInlet":0},{"id":"pline-1","sourceId":"obj-11","sourceOutlet":0,"targetId":"obj-12","targetInlet":0},{"id":"pline-2","sourceId":"obj-12","sourceOutlet":0,"targetId":"obj-23","targetInlet":0,"midpoints":[132.5,239,320.5,239]},{"id":"pline-3","sourceId":"obj-12","sourceOutlet":0,"targetId":"obj-24","targetInlet":0,"midpoints":[132.5,239,233.5,239]},{"id":"pline-4","sourceId":"obj-12","sourceOutlet":0,"targetId":"obj-25","targetInlet":0,"midpoints":[132.5,239,146.5,239]},{"id":"pline-5","sourceId":"obj-13","sourceOutlet":0,"targetId":"obj-16","targetInlet":1},{"id":"pline-6","sourceId":"obj