2","objectNameHint":"gamepad","headerHeightPx":138,"headerRect":[10,10,678,138]},"stats":{"boxCount":15,"lineCount":11,"presentationBoxCount":0}},"advanced":{"pageName":"advanced","pageId":"advanced__obj-2","renderMode":"page-subpatcher","patcherRect":[100,126,697,742],"boxes":[{"id":"obj-7","maxclass":"message","text":"clear","rect":[53,443,37,23],"patchingRect":[53,443,37,23],"numinlets":2,"numoutlets":1},{"id":"obj-3","maxclass":"messageview","text":"","rect":[10,474,320,252],"patchingRect":[10,474,320,252],"numinlets":1,"numoutlets":1,"fontname":"Arial","fontsize":13,"fontface":0},{"id":"obj-24","maxclass":"comment","text":"Output raw SDL joystick data, rather than gamepad mapped data. This can be helpful for generating a device mapping, or diagnosing gamepad device mapping issues. This applies to all devices and all instances.","rect":[171,284,448,50],"patchingRect":[171,284,448,50],"numinlets":1,"numoutlets":0,"linecount":3},{"id":"obj-22","maxclass":"comment","text":"polling interval (ms)","rect":[171,248,135,21],"patchingRect":[171,248,135,21],"numinlets":1,"numoutlets":0},{"id":"obj-21","maxclass":"comment","text":"All gamepad objects are fed by a single global gamepad instance that sends events to the individual gamepad objects in a patcher. Attributes like interval or raw data will apply to this global object, and therefore for all instances in patchers.\n\nSDL 2 takes raw joystick data from various drivers and maps it to a gamepad based on its internal mappings. Users can create their own mapping for a given device specifed by GUID and platform. Mappings can be loaded by file with the addmappingfile <filename> message or addmapping <mapping text>.\n\nThe community sourced Game Controller DB Project has many additional and example mappings. If a file named gamecontrollerdb.txt is in the Max search path it will be loaded on first gamepad instantiation. \nhttps://github.com/mdqinc/SDL_GameControllerDB","rect":[10,81,708,152],"patchingRect":[10,81,708,152],"