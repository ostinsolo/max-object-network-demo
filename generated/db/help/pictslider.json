nt":"pictslider","headerHeightPx":144,"headerRect":[10,10,623,144]},"stats":{"boxCount":21,"lineCount":13,"presentationBoxCount":0}},"picture_format":{"pageName":"picture_format","pageId":"picture-format__obj-31","renderMode":"page-subpatcher","patcherRect":[0,26,784,456],"boxes":[{"id":"obj-14","maxclass":"comment","text":"Although the mask images shown in the diagram is supported for legacy purposes, Max 5 users should use the alpha channel to create transparent backgrounds.","rect":[28,218,286,66],"patchingRect":[28,218,286,66],"numinlets":1,"numoutlets":0,"fontname":"Arial","fontsize":13,"linecount":4},{"id":"obj-1","maxclass":"comment","text":"Slider Background Picture Format:","rect":[482,129,218,21],"patchingRect":[482,129,218,21],"numinlets":1,"numoutlets":0,"fontname":"Arial","fontsize":13},{"id":"obj-2","maxclass":"number","text":"0","rect":[143,404,35,20],"patchingRect":[143,404,35,20],"numinlets":1,"numoutlets":2,"fontname":"Arial","fontsize":11.595187,"textcolor":[0,0,0,1],"bgcolor":[0.866667,0.866667,0.866667,1],"parameterEnable":0},{"id":"obj-3","maxclass":"pictslider","text":"","rect":[143,357,228,24],"patchingRect":[143,357,228,24],"numinlets":2,"numoutlets":2,"parameterEnable":0},{"id":"obj-4","maxclass":"comment","text":"The mask images allow you to create knobs with non-rectangular outlines. Black regions of the mask indicate what regions of the images should be drawn, white regions are transparent, i.e. allow the background to be visible. Grey regions create translucency. (Note: if you use a mask with grey regions in a pictslider with an invisible background, the knob will not be drawn correctly when moved. Stick to black & white masks for sliders with invisible backgrounds.)","rect":[288,8,487,96],"patchingRect":[288,8,487,96],"numinlets":1,"numoutlets":0,"fontname":"Arial","fontsize":13,"linecount":6},{"id":"obj-5","maxclass":"fpic","text":"","rect":[43,40,231,96],"patchingRect":[43,40,231,96],"numinlets":1,"numoutlets":1},{"id":"obj-6","maxclass":"comment","text":"Slider Knob Picture Format:","rect":[29,10,214,21],"patchingRect":[29,10,214,21],"numinlets":1,"numoutlets":0,"fontname":"Arial","fontsize":13},{"id":"obj-7","maxclass":"comment","text":"All images in the picture have the same dimensions. The 'clicked' and 'inactive' images are optional, as are the image masks. The corresponding check boxes in the Inspector must be set to correspond to the presence/absence of the images.","rect":[27,149,376,66],"patchingRect":[27,149,376,66],"numinlets":1,"numoutlets":0,"fontname":"Arial","fontsize":13,"linecount":4},{"id":"obj-8","maxclass":"comment","text":"When you choose a picture for the background, you can choose that the slider is automatically resized to match by checking a checkbox in the open-file dialog. The size of the bounding box depends on both the size of the picture and the settings in the Inspector, so if your picture doesn't look right, check your settings.","rect":[26,287,488,66],"patchingRect":[26,287,488,66],"numinlets":1,"numoutlets":0,"fontname":"Arial","fontsize":13,"linecount":4},{"id":"obj-9","maxclass":"comment","text":"Here's an example slider that uses a mask on its knob image:","rect":[26,354,117,66],"patchingRect":[26,354,117,66],"numinlets":1,"numoutlets":0,"fontname":"Arial","fontsize":13,"linecount":4},{"id":"obj-10","maxclass":"comment","text":"Its knob picture file contains this image:","rect":[225,408,127,36],"patchingRect":[225,408,127,36],"numinlets":1,"numoutlets":0,"fontname":"Arial","fontsize":13,"linecount":2},{"id":"obj-11","maxclass":"fpic","text":"","rect":[352,404,76,44],"patchingRect":[352,404,76,44],"numinlets":1,"numoutlets":1},{"id":"obj-12","maxclass":"fpic","text":"","rect":[495,156,154,48],"patchingRect":[495,156,154,48],"numinlets":1,"numoutlets":1},{"id":"obj-13","maxclass":"comment","text":"The slider background picture is considerably simpler—it has only two images at most. Note that it must have an inactive image if the knob used in the control has an