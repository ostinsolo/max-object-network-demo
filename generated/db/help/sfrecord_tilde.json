-14","targetInlet":0,"midpoints":[100.5,235.75,100.5,235.75]},{"id":"pline-16","sourceId":"obj-27","sourceOutlet":0,"targetId":"obj-14","targetInlet":0},{"id":"pline-17","sourceId":"obj-6","sourceOutlet":0,"targetId":"obj-14","targetInlet":0,"midpoints":[499.5,315,100.5,315]}],"stats":{"boxCount":25,"lineCount":18,"presentationBoxCount":0}},"buffer_size":{"pageName":"buffer_size","pageId":"buffer-size__obj-6","renderMode":"page-subpatcher","patcherRect":[0,26,705,460],"boxes":[{"id":"obj-33","maxclass":"jit.cellblock","text":"","rect":[184,277,334,163],"patchingRect":[184,277,334,163],"numinlets":2,"numoutlets":4,"fontname":"Arial","fontsize":13,"fontface":0},{"id":"obj-29","maxclass":"comment","text":"Some useful values:","rect":[48,341,128,21],"patchingRect":[48,341,128,21],"numinlets":1,"numoutlets":0},{"id":"obj-30","maxclass":"comment","text":"Soundfiles with up to 64 channels are now supported, but it is up to the user to ensure that the disk buffer is an integer multiple of 20160 and the product of the number of channels and the sample type bytewidth-e.g. if one wishes to use 9 channel sound files of all possible bytewidths the diskbuffer must be equal to a multiple 181440=9*20160 bytes. However, if one wishes to use 9 channel sound files that have bytewidths other than 3, the diskbuffer size may be a multiple of 60480=3*20160 bytes because 3 is a factor of 20160.","rect":[10,183,682,79],"patchingRect":[10,183,682,79],"numinlets":1,"numoutlets":0,"linecount":5},{"id":"obj-31","maxclass":"comment","text":"The diskbuffer size is rounded to the the nearest multiple of 20160 bytes. At first this might seem like an odd number but it is equal to 8 factorial over 2 (8! = 8*7*6*5*4*3*2*1). This is used so that we can ensure that there is no frame wrap around as we wrap around the diskbuffer end. There will be no frame wrap if the diskbufffer size is an integer multiple of the product of the number of channels and the sample type bytewidth of the soundfile being played. If the diskbuffer size is a multiple of 20160, there will be no wrap for all of the channel/sampletype pairs possible for 8 channels or less (possible bytewidths are 1, 2, 3, 4, and 8--8bit, 16bit, 24bit, 32bit, and 64bit respectively).","rect":[10,58,680,94],"patchingRect":[10,58,680,94],"numinlets":1,"numoutlets":0,"linecount":6},{"id":"obj-32","maxclass":"comment","text":"More than 8 channels:","rect":[10,162,206,21],"patchingRect":[10,162,206,21],"numinlets":1,"numoutlets":0}],"lines":[],"stats":{"boxCount":5,"lineCount":0,"presentationBoxCount":0}}},"patcherRect":[100,113,705,460],"boxes":[{"id":"obj-21","maxclass":"comment","text":"elapsed time (ms)","rect":[160.5,390,117,21],"patchingRect":[160.5,390,117,21],"numinlets":1,"numoutlets":0},{"id":"obj-20","maxclass":"comment","text":"soundfile input for channel 2 (R)","rect":[269.5,319,115,36],"patchingRect":[269.5,319,115,36],"numinlets":1,"numoutlets":0,"linecount":2},{"id":"obj-19","maxclass":"comment","text":"soundfile input for channel 1 (L)","rect":[111,319,115,36],"patchingRect":[111,319,115,36],"numinlets":1,"numoutlets":0,"linecount":2},{"id":"obj-18","maxclass":"comment","text":"alternatively, the record message will start recording for a fixed amount of time (in milliseconds) and then stop.","rect":[325,262.5,352,36],"patchingRect":[325,262.5,352,36],"numinlets":1,"numoutlets":0,"linecount":2},{"id":"obj-17","maxclass":"comment","text":"toggle on to start recording, toggle off to stop and close the file","rect":[230,218,401,25],"patchingRect":[230,218,401,25],"numinlets":1,"numoutlets":0,"fontname":"Arial","fontsize":13,"bubble":1},{"id":"obj-15","maxclass":"comment","text":"start audio and get microphone ready","rect":[193.5,178,249,25],"patchingRect":[193.5,178,249,25],"numinlets":1,"numoutlets":0,"fontname":"Arial","fontsize":13,"bubble":1},{"id":"obj-13","maxclass":"meter~","text":"","rect":[146.5,218,12,67],"patchingRect":[146.5,218,12,67],"numinlets":1,"numoutlets":1},{"id":"obj-12","maxclass