":0,"targetId":"obj-29","targetInlet":0,"midpoints":[544.5,343,48.5,343]},{"id":"pline-6","sourceId":"obj-22","sourceOutlet":0,"targetId":"obj-29","targetInlet":0,"midpoints":[127.5,342,48.5,342]},{"id":"pline-7","sourceId":"obj-24","sourceOutlet":0,"targetId":"obj-29","targetInlet":0,"midpoints":[113.5,342,48.5,342]},{"id":"pline-8","sourceId":"obj-26","sourceOutlet":0,"targetId":"obj-29","targetInlet":0,"midpoints":[99.5,342.5,48.5,342.5]},{"id":"pline-9","sourceId":"obj-27","sourceOutlet":0,"targetId":"obj-29","targetInlet":0,"midpoints":[85.5,342.5,48.5,342.5]},{"id":"pline-10","sourceId":"obj-28","sourceOutlet":0,"targetId":"obj-29","targetInlet":0,"midpoints":[48.5,348.5,48.5,348.5]}],"helpdetailsHeaderHints":{"sourceBoxId":"obj-2","objectNameHint":"sflist~","headerHeightPx":125,"headerRect":[10,10,620,125]},"stats":{"boxCount":25,"lineCount":11,"presentationBoxCount":0}},"buffer_size":{"pageName":"buffer_size","pageId":"buffer-size__obj-3","renderMode":"page-subpatcher","patcherRect":[0,26,815,447],"boxes":[{"id":"obj-33","maxclass":"jit.cellblock","text":"","rect":[227.5,257,334,163],"patchingRect":[227.5,257,334,163],"numinlets":2,"numoutlets":4,"fontname":"Arial","fontsize":13,"fontface":0},{"id":"obj-29","maxclass":"comment","text":"Some useful values:","rect":[91.5,321,128,21],"patchingRect":[91.5,321,128,21],"numinlets":1,"numoutlets":0},{"id":"obj-30","maxclass":"comment","text":"Soundfiles with 9-16 channels are now supported, but it is up to the user to ensure that the disk buffer is an integer multiple of 20160 and the product of the number of channels and the sample type bytewidth-e.g. if one wishes to use 9 channel sound files of all possible bytewidths the diskbuffer must be equal to a multiple 181440=9*20160 bytes. However, if one wishes to use 9 channel sound files that have bytewidths other than 3, the diskbuffer size may be a multiple of 60480=3*20160 bytes because 3 is a factor of 20160.","rect":[10,176,773,79],"patchingRect":[10,176,773,79],"numinlets":1,"numoutlets":0,"linecount":5},{"id":"obj-31","maxclass":"comment","text":"The diskbuffer size is rounded to the the nearest multiple of 20160 bytes. At first this might seem like an odd number but it is equal to 8 factorial over 2 (8! = 8*7*6*5*4*3*2*1). This is used so that we can ensure that there is no frame wrap around as we wrap around the diskbuffer end. There will be no frame wrap if the diskbufffer size is an integer multiple of the product of the number of channels and the sample type bytewidth of the soundfile being played. If the diskbuffer size is a multiple of 20160, there will be no wrap for all of the channel/sampletype pairs possible for 8 channels or less (possible bytewidths are 1, 2, 3, 4, and 8--8bit, 16bit, 24bit, 32bit, and 64bit respectively).","rect":[10,59,769,94],"patchingRect":[10,59,769,94],"numinlets":1,"numoutlets":0,"linecount":6},{"id":"obj-32","maxclass":"comment","text":"More than 8 channels:","rect":[10,155,206,21],"patchingRect":[10,155,206,21],"numinlets":1,"numoutlets":0}],"lines":[],"stats":{"boxCount":5,"lineCount":0,"presentationBoxCount":0}}},"patcherRect":[40,105,815,447],"boxes":[{"id":"obj-15","maxclass":"newobj","text":"p more cues","rect":[593,326,82,23],"patchingRect":[593,326,82,23],"numinlets":0,"numoutlets":1,"fontname":"Arial","fontsize":13},{"id":"obj-16","maxclass":"message","text":"embed 0","rect":[563,290,63,23],"patchingRect":[563,290,63,23],"numinlets":2,"numoutlets":1,"fontname":"Arial","fontsize":13},{"id":"obj-17","maxclass":"message","text":"embed 1","rect":[564,249,63,23],"patchingRect":[564,249,63,23],"numinlets":2,"numoutlets":1,"fontname":"Arial","fontsize":13},{"id":"obj-18","maxclass":"message","text":"clear","rect":[564,218,41,23],"patchingRect":[564,218,41,23],"numinlets":2,"numoutlets":1,"fontname":"Arial","fontsize":13},{"id":"obj-19","maxclass":"message","text":"clear 2 3","rect":[564,185,62,23],"patchingRect":[564,185,62,23],"numinlets":2,"numoutlets":1,"fontname":"Arial","fonts